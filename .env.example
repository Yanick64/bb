# BB is single-operator and binds to loopback by default.
BB_HOST=127.0.0.1
BB_PORT=4310
BB_DATA_DIR=./data
# Required when exposing BB beyond loopback. Use a long random password.
BB_PASSWORD=
# Public HTTPS origin, needed for Amp to reach the optional BB MCP endpoint.
BB_PUBLIC_URL=
# Incoming Orbit webhooks: use Bearer auth or HMAC-SHA256 in X-BB-Signature.
BB_ORBIT_WEBHOOK_SECRET=
# Amp uses your existing CLI login, or an access token on an unattended server.
AMP_BIN=amp
AMP_API_KEY=
BB_AMP_ENABLED=false
BB_WORKER_CONCURRENCY=2
# Orbit Streamable HTTP MCP URL and optional bearer token, configured separately
# from the coding assistant's MCP connection.
ORBIT_MCP_URL=
ORBIT_MCP_TOKEN=
ORBIT_WEB_URL=
# Sentry MCP uses OAuth. Complete login in the Connections screen.
SENTRY_MCP_URL=https://mcp.sentry.dev/mcp
# Optional REST fallback. Region: https://sentry.io or your regional host.
SENTRY_BASE_URL=https://sentry.io
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
