    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/bun": "latest",
